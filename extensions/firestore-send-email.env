# Trigger Email extension configuration (firebase/firestore-send-email).
#
# Deployed with:  firebase deploy --only extensions --project <dev|prod>
# The version itself is pinned in firebase.json.
#
# Upgraded prod 0.1.34 -> 0.2.4 on 2026-09-04. The old instance ran 1st-gen on
# nodejs18, which Google decommissioned, so EVERY change to it - including a
# settings-only one - was rejected with DEPLOYS_NOT_ALLOWED. It still delivered,
# because existing deployments keep running, but it could not be touched. The
# upgrade was the only way back to a mutable, supported mail path.
#
# SMTP_PASSWORD is a Secret Manager REFERENCE, not a password. ${param:PROJECT_NUMBER}
# resolves per project, so this file is portable between dev and prod.
#
# AUTH_TYPE matters more than it looks: SMTP_CONNECTION_URI is user:pass form, and
# a wrong AUTH_TYPE breaks authentication for ALL ministry email. That is the
# likely cause of the 78 "535 Incorrect authentication data" failures in mid-2025.
# Do not let an `ext:update --force` pick a default for it.

DEFAULT_FROM=Impact Disciples <info@impactdisciples.com>
DEFAULT_REPLY_TO=Impact Disciples <info@impactdisciples.com>
MAIL_COLLECTION=mail
TEMPLATES_COLLECTION=mail_templates
USERS_COLLECTION=users
SMTP_CONNECTION_URI=smtp://admin@impactdisciples.com@mail.impactdisciples.com:26
SMTP_PASSWORD=projects/${param:PROJECT_NUMBER}/secrets/firestore-send-email-SMTP_PASSWORD/versions/latest
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=nam5
OAUTH_PORT=465
OAUTH_SECURE=true

firebaseextensions.v1beta.function/location=us-central1
firebaseextensions.v1beta.function/minInstances=0
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
firebaseextensions.v1beta.v2function/memory=256Mi

# CONCURRENCY IS NOT SET HERE, and cannot be. maxInstances is the ceiling on
# simultaneous SMTP connections (the processor runs one request per instance),
# and it is what the June 2025 blast breached - the relay answered "421 Too many
# concurrent SMTP connections" and the account saw rejected logins for months
# afterwards.
#
# Both declarative routes ACCEPT the setting and silently ignore it: a
# `firebaseextensions.v1beta.v2function/maxInstances` line here, and a PATCH of
# config.systemParams through the Extensions REST API (verified on dev, both
# field-path spellings). Neither errors, which is the trap.
#
# It is set directly on the underlying Cloud Function instead:
#
#   ext-firestore-send-email-processqueue  ->  serviceConfig.maxInstanceCount = 5
#
# Currently 5 on prod (default is 100). RE-CHECK IT AFTER ANY EXTENSION UPDATE -
# a version change resets it, and nothing will warn you.

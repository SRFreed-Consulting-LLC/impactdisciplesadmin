rules_version = '2';

// ============================================================================
// Unified rules for impactdisciplesdev's (default) database - Phase 7 of the
// consolidation plan. ONE file, owned by THIS repo (impactdisciples-admin);
// the web and reader repos deliberately deploy no Firestore rules (their
// firebase.json firestore blocks were removed so a stray deploy can't clobber
// this).
//
// Three client populations:
//   - The public web site (impactdisciples-web): NO Firebase Auth at all -
//     every request is anonymous. Public catalog collections stay
//     world-readable; a handful of checkout/registration flows keep
//     narrowly-scoped anonymous writes (marked PRE-PROD below - each is
//     slated to move behind a Cloud Function before real public traffic).
//   - Admin staff (impactdisciples-admin): identified by the `role` CUSTOM
//     CLAIM ('Admin'|'Root'|'Employee'|'Editor'), synced from admin_users by
//     the onAdminUserRoleSync trigger. Rules can NOT look admin_users up by
//     uid (auto-id docs, firebaseUID is a field), so the claim is the only
//     mechanism. Deploy order matters: trigger + backfill BEFORE these rules,
//     and staff must refresh their ID token (sign out/in) to pick claims up.
//   - Reader patrons (impact-discipleship-library): signed-in Firebase Auth
//     users identified by their token EMAIL (libraryUsers is email-keyed).
//     Their mutations largely go through Cloud Functions (Phase 6); the
//     writes deliberately left direct (offline-preserving split) are locked
//     to owner-path scope below.
//
// Cloud Functions use the Admin SDK and BYPASS all of this - "write: false"
// on a collection functions write to is intentional lockdown, not breakage.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identity helpers --------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    // The staff role custom claim; '' for patrons/anonymous. token.get()
    // (not token.role) so accounts without the claim don't error.
    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }
    function isAdminRole() {
      return role() in ['Admin', 'Root'];
    }
    // Any staff tier at all - the read floor for the staff registry itself.
    function isStaffAny() {
      return role() in ['Admin', 'Root', 'Employee', 'Editor'];
    }
    // Business staff: the admin app's store/events/customers/... managers.
    // Editors are deliberately excluded - their scope is the library only.
    function isBusinessStaff() {
      return role() in ['Admin', 'Root', 'Employee'];
    }
    // Library content authors. Employees are deliberately excluded - they
    // never see the Library section.
    function isLibraryStaff() {
      return role() in ['Admin', 'Root', 'Editor'];
    }
    function callerEmail() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    // ---- Reader access helpers (ported from the library submodule rules,
    // ---- staff checks swapped from the dead adminUsers lookup to claims) --
    function hasBookLicense(bookId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/libraryUsers/$(callerEmail())) &&
        get(/databases/$(database)/documents/libraryUsers/$(callerEmail())).data.get('revoked', false) != true &&
        bookId in get(/databases/$(database)/documents/libraryUsers/$(callerEmail())).data.licensedBookIds;
    }
    function isInternationalPatron() {
      return signedIn() &&
        exists(/databases/$(database)/documents/libraryUsers/$(callerEmail())) &&
        get(/databases/$(database)/documents/libraryUsers/$(callerEmail())).data.get('revoked', false) != true &&
        get(/databases/$(database)/documents/libraryUsers/$(callerEmail())).data.get('internationalUser', false) == true;
    }
    function canReadBook(bookId) {
      return isLibraryStaff() || isInternationalPatron() || hasBookLicense(bookId);
    }
    // Approved membership in an Impact Group - backs the stay-direct chat/
    // prayer content writes.
    function isApprovedGroupMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/discussionGroups/$(groupId)/members/$(callerEmail())) &&
        get(/databases/$(database)/documents/discussionGroups/$(groupId)/members/$(callerEmail())).data.status == 'approved';
    }
    function isGroupCreator(groupId) {
      return signedIn() &&
        get(/databases/$(database)/documents/discussionGroups/$(groupId)).data.creatorEmail == callerEmail();
    }
    // A member doc EXISTS for this email in this group, ANY status. Weaker
    // than isApprovedGroupMember on purpose: a conversation with a pending or
    // rejected applicant must keep working (see DiscussionGroupService), but
    // a total non-member must not.
    function groupMemberExists(groupId, email) {
      return signedIn() &&
        exists(/databases/$(database)/documents/discussionGroups/$(groupId)/members/$(email));
    }

    // ========================================================================
    // SECTION 1 - Public catalog (web site reads anonymously; staff author)
    // ========================================================================
    match /config/{id} {
      allow read: if true;                  // paypalClientId, business info -
      allow write: if isAdminRole();        // model docs say: NO secrets here
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /product_categories/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /product_tags/{id} {
      allow read: if isBusinessStaff();
      allow write: if isBusinessStaff();
    }
    match /sales/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /series/{id} {                    // Store Manager's Product Series -
      allow read: if true;                  // NOT library series (librarySeries)
      allow write: if isBusinessStaff();
    }
    match /events/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /courses/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /coaches/{id} {
      allow read: if true;                  // documentId()-in queries = list
      allow write: if isBusinessStaff();
    }
    match /impact_team/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /locations/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /home_page_images/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /home_page_popups/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /pod_casts/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /pod_cast_categories/{id} {
      allow read: if isBusinessStaff();
      allow write: if isBusinessStaff();
    }
    match /pod_cast_tags/{id} {
      allow read: if isBusinessStaff();
      allow write: if isBusinessStaff();
    }
    match /dmms/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /monthly-newsletter/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    // Dynamic form definitions: public pages load ONE form by id; only staff
    // may browse the registry.
    match /forms/{id} {
      allow get: if true;
      allow list: if isBusinessStaff();
      allow write: if isBusinessStaff();
    }
    // Read by the web's client-side email sender (template by name/id).
    match /mail_templates/{id} {
      allow read: if true;
      allow write: if isBusinessStaff();
    }
    // Staff-only since pre-prod hardening #5: both storefronts resolve a
    // single code through the lookup_coupon/lookupCoupon functions now, so
    // nothing legitimate lists this collection from a client any more (a
    // world-readable list let anyone enumerate every discount code).
    match /coupons/{id} {
      allow read, write: if isBusinessStaff();
    }

    // ========================================================================
    // SECTION 2 - Anonymous-write flows the public site depends on.
    // PRE-PROD: every ANON write below is slated to move behind a Cloud
    // Function before real public traffic (see the consolidation plan's
    // pre-prod checklist). Until then: create-only wherever possible, and
    // reads locked to staff wherever no public flow needs them.
    // ========================================================================
    // Create stays anonymous (public contact/consultation forms) but is
    // shape-constrained to the exact fields the two real writers send (the
    // web app's dynamic-form.component.ts and the admin form builder's
    // test-submit dialog): no extra keys, typed fields, generous size caps
    // on the free-text ones. `values` is the visitor's answers map - its
    // per-answer text is uncapped here (rules can't iterate map values);
    // Firestore's own 1MB doc limit is the backstop.
    match /form_submissions/{id} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'formId', 'formName', 'fieldSnapshot', 'values', 'submittedAt',
          'newRecordStatus', 'isTest'
        ]) &&
        request.resource.data.formId is string &&
        request.resource.data.formId.size() <= 500 &&
        request.resource.data.formName is string &&
        request.resource.data.formName.size() <= 500 &&
        request.resource.data.fieldSnapshot is list &&
        request.resource.data.values is map &&
        request.resource.data.submittedAt is timestamp &&
        (!('newRecordStatus' in request.resource.data) ||
          request.resource.data.newRecordStatus in ['new', 'seen']) &&
        (!('isTest' in request.resource.data) ||
          request.resource.data.isTest is bool);
      allow read, update, delete: if isBusinessStaff();
    }
    // Staff-only since pre-prod hardening #2: every public flow (RSVP
    // create + confirmation email, emailed-link lookup, breakout session
    // changes, duplicate check, capacity counts) goes through the
    // event-registration Cloud Functions now - credentialed by the
    // registration's own unguessable id from the emailed link, with
    // disclosure reduced to per-session counts. The old anonymous
    // read/create/update surface (roster enumeration, whole-doc
    // overwrites, email-as-credential lookups) is closed.
    match /event-registrations/{id} {
      allow read, update, delete: if isBusinessStaff();
      allow create: if false;
    }
    // eventSessionCounts (per-event session-count counters, maintained by
    // the onEventRegistrationSessionCounts trigger and served through
    // get_session_counts) is functions-only - unmatched here on purpose, so
    // it falls to the default deny.
    // PRE-PROD: open create = open email relay (Trigger Email extension
    // sends whatever lands here). Web receipts/confirmations + the reader's
    // own LegacyMailService both write it; the extension itself uses the
    // Admin SDK. Shape-constrained to the exact fields both apps write.
    match /mail/{id} {
      // Pre-prod hardening #1: anonymous create is CLOSED. Every public
      // mail path (order receipts, follow-ups, subscription confirmations,
      // event-registration confirmations, group invites/declines, reader
      // store receipts) is queued by a Cloud Function via the Admin SDK
      // now. Client-side creates remain only for the admin app's own
      // staff-composed emails (attendee blasts, resends). Shape stays
      // constrained: {to, date, message{...}} or {to, date, template{...}}
      // - the template form has NO message field, so the message-shape
      // check must be conditional (accessing a missing key throws, which
      // reads as a deny).
      allow create: if isBusinessStaff() &&
        request.resource.data.keys().hasOnly(['to', 'date', 'message', 'template']) &&
        (!('message' in request.resource.data) ||
          request.resource.data.message.keys().hasOnly(['subject', 'html', 'text']));
      allow read, update, delete: if isBusinessStaff();
    }
    // Anonymous create is REQUIRED even for the admin app: failed-login
    // logging happens before a session exists. Shape-constrained to what
    // LoggerService.logMessage actually writes (identical model in the web
    // and admin apps; both always stamp id/date/type/message/error_code/
    // archived and include `data` only when truthy - `data` itself is
    // arbitrary diagnostic JSON, left untyped, with Firestore's 1MB doc
    // limit as the backstop). The LogMessage constructor never assigns its
    // created_by param, so no writer sends that field.
    match /log-messages/{id} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'id', 'date', 'type', 'message', 'data', 'error_code', 'archived'
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() <= 100 &&
        request.resource.data.date is timestamp &&
        request.resource.data.type is string &&
        request.resource.data.type.size() <= 500 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 10000 &&
        request.resource.data.error_code is string &&
        request.resource.data.error_code.size() <= 500 &&
        request.resource.data.archived is bool;
      allow read, update, delete: if isAdminRole();
    }
    match /affilliate_sales/{id} {          // (sic - 3 L's, matches the code)
      // Anonymous create CLOSED (sweep 2026-08-17): the web checkout used
      // to write this client-side, which let anyone forge affiliate
      // attribution. The checkout Cloud Function (paypal.functions.ts,
      // recordAffiliateSale) writes it server-side now from the
      // server-computed order.
      allow create, read, update, delete: if isBusinessStaff();
    }
    // Closed since pre-prod hardening #4: totals are rolled up SERVER-side
    // by the onPurchaseTaxSummary purchases trigger now (idempotent,
    // derived from the purchase doc itself) - the old checkout-success
    // anonymous read-modify-write is gone. Staff can read for reporting.
    match /tax_rate_summaries/{id} {
      allow read: if isBusinessStaff();
      allow write: if false;
    }
    // impact-users (the LEGACY digital-library license store) was retired
    // 2026-08-17 (pre-prod #3): verified write-only-with-no-reader across
    // all repos, empty in this database, and its checkout-success write
    // flow removed from the web app - unmatched here on purpose, so it
    // falls to the default deny.

    // ========================================================================
    // SECTION 3 - Staff / server-only business collections
    // ========================================================================
    // Staff registry. Reads: every staff role resolves its own doc by email
    // query at sign-in. Writes: role/permission edits are Admin/Root-only
    // client updates; create/delete go through Cloud Functions (Admin SDK).
    // A write here propagates into the role CLAIM via onAdminUserRoleSync -
    // that's why update is the only client verb and is admin-gated.
    match /admin_users/{id} {
      allow read: if isStaffAny();
      allow update: if isAdminRole();
      allow create, delete: if false;
    }
    match /user_permissions/{id} {          // legacy per-user grants, loaded
      allow read: if isStaffAny();          // at sign-in for every role
      allow write: if isAdminRole();
    }
    match /customers/{id} {
      allow read, write: if isBusinessStaff();
    }
    // Created by Cloud Functions only (PayPal checkout, reader store, group
    // licenses); staff update fulfillment fields from the admin UI.
    match /purchases/{id} {
      allow read, update: if isBusinessStaff();
      allow create, delete: if false;
    }
    match /pending_orders/{id} {            // functions-only staging
      allow read, write: if false;
    }
    match /meta/{id} {                      // newRecordCounts alert counters -
      allow read: if isBusinessStaff();     // written by functions only
      allow write: if false;
    }
    match /integration_settings/{id} {
      allow read, write: if isAdminRole();
    }
    match /shipping-labels/{id} {
      allow read, write: if isBusinessStaff();
    }
    match /shipping-label-batches/{id} {
      allow read, write: if isBusinessStaff();
    }
    match /affilliate_payments/{id} {
      allow read, write: if isBusinessStaff();
    }
    match /campaigns/{id} {
      allow read, write: if isBusinessStaff();
    }
    // The email body behind a type-'email' campaign (Sent Emails history) -
    // same doc id as the campaign doc. Imported by the Admin SDK
    // (scripts/import-mailchimp-campaigns.js); staff read for preview/
    // start-from, staff write so future in-app one-time sends can record
    // their own history the same way.
    match /campaign_emails/{id} {
      allow read, write: if isBusinessStaff();
    }
    // Customer tag rules (Campaigns Manager > Tag Rules) - staff-authored.
    match /tag_rules/{id} {
      allow read, write: if isBusinessStaff();
    }
    // Per-(customer, tag) application record - when/why a tag landed, and
    // the anchor date the auto-campaign scheduler counts from. Normally
    // written by the Admin SDK (upsert triggers / retroactive sweep); the
    // client's only legitimate writes are the manual add/remove on the
    // customer-details tag chips. Updates never happen (a tag application
    // is immutable - remove and re-add instead).
    match /tag_applications/{id} {
      allow read, create, delete: if isBusinessStaff();
      allow update: if false;
    }
    // Per-recipient campaign send ledger - send-engine-only writes
    // (Admin SDK); staff can read it for auditing.
    match /campaign_sends/{id} {
      allow read: if isBusinessStaff();
      allow write: if false;
    }
    // Raw engagement event stream (opens/clicks/attribution) - written
    // only by the tracking endpoints (Admin SDK); staff read for audit.
    match /campaign_events/{id} {
      allow read: if isBusinessStaff();
      allow write: if false;
    }
    match /prayers/{id} {
      allow read, write: if isBusinessStaff();
    }
    match /newsletters/{id} {
      allow read, write: if isBusinessStaff();
    }
    match /organizations/{id} {
      allow read, write: if isBusinessStaff();
    }
    match /event-announcements/{id} {
      allow read, write: if isBusinessStaff();
    }
    match /customer_emails/{id} {
      allow read, write: if isBusinessStaff();
    }
    // Dead collections (migrated away / never used) - deny outright.
    match /subscriptions/{id} {
      allow read, write: if false;
    }
    match /shipments/{id} {
      allow read, write: if false;
    }

    // ========================================================================
    // SECTION 4 - Library content (nested schema, Phase 3)
    // ========================================================================
    match /librarySeries/{seriesId} {
      allow read: if signedIn();
      allow write: if isLibraryStaff();

      // Book metadata is readable by any signed-in patron regardless of
      // license (Groups needs titles for unowned books); lesson CONTENT is
      // license-gated below. bookId is the rules PATH variable - always
      // present, no denormalized field or get() needed.
      match /books/{bookId} {
        allow read: if signedIn();
        allow write: if isLibraryStaff();

        match /units/{unitId} {
          allow read: if canReadBook(bookId);
          allow write: if isLibraryStaff();

          match /lessons/{lessonId} {
            allow read: if canReadBook(bookId);
            allow write: if isLibraryStaff();

            // License-gated (sweep 2026-08-17): a translation doc carries
            // the FULL original + translated lesson text, so it must be
            // gated exactly like the lesson above it - a bare signedIn()
            // read was a paywall bypass for every translated book. The
            // reader's language picker no longer scans these (see the
            // appConfig/availableLanguages registry below).
            match /translations/{translationId} {
              allow read: if canReadBook(bookId);
              allow write: if isLibraryStaff();
            }
          }
        }
      }
    }
    // Collection-group translations read is STAFF-ONLY now (sweep
    // 2026-08-17). It used to be signedIn() to serve the reader's
    // "which languages exist" discovery, which exposed every translated
    // lesson's full text to any account. That discovery reads the tiny
    // appConfig/availableLanguages registry instead; only the admin app's
    // own services scan the whole collection group.
    match /{path=**}/translations/{translationId} {
      allow read: if isLibraryStaff();
    }
    // Distinct-locale registry for the reader's language picker, maintained
    // by the onTranslationLocaleRegistry trigger. Holds only locale
    // codes/labels - no lesson content - so it's safe for any signed-in
    // patron to read; writes are the trigger's (Admin SDK) alone.
    match /appConfig/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Collection-group reads - the nested match blocks above do NOT apply
    // to collectionGroup() queries. `books` stays signedIn-open: book
    // METADATA is readable by any patron regardless of license (Groups
    // browses unowned books), and it's the entry point the reader resolves
    // real nested paths from. units/lessons collection-group scans are
    // STAFF-ONLY (pre-prod hardening #7): the admin app's Library services
    // legitimately scan whole collections, but every patron read is a
    // constrained nested-path query now, license-gated by canReadBook's
    // path variable - an unconstrained scan from a patron has no
    // legitimate source and would bypass license enforcement.
    match /{path=**}/books/{bookId} {
      allow read: if signedIn();
    }
    match /{path=**}/units/{unitId} {
      allow read: if isLibraryStaff();
    }
    match /{path=**}/lessons/{lessonId} {
      allow read: if isLibraryStaff();
    }
    // "My memberships" - the reader queries the members collection-group
    // filtered by its own email; the equality filter makes the
    // owner-scoping provable. Admin sees all.
    match /{path=**}/members/{memberEmail} {
      allow read: if signedIn() &&
        (resource.data.email == callerEmail() || isAdminRole());
    }

    // Library staff authoring artifacts.
    match /subtemplates/{id} {
      allow read, write: if isLibraryStaff();
    }
    match /lessonTemplates/{id} {
      allow read, write: if isLibraryStaff();
    }
    match /titleTranslations/{id} {
      allow read: if signedIn();
      allow write: if isLibraryStaff();
    }
    match /commonTranslations/{id} {
      allow read: if signedIn();
      allow write: if isLibraryStaff();
    }
    // Image docs are only ever fetched by known doc id (a content hash the
    // reader resolves from a license-gated lesson's own 'lessonimage:{id}'
    // schema placeholders, verified across the reader/manager/admin apps -
    // no client lists this collection). A signedIn() LIST would have let
    // any patron enumerate every book's lesson images without a license,
    // so listing is staff-only.
    match /lessonImages/{id} {
      allow get: if signedIn();
      allow list: if isLibraryStaff();
      allow write: if isLibraryStaff();
    }
    match /bulkDiscountTiers/{id} {
      allow read: if signedIn();            // patrons price group licenses
      allow write: if isAdminRole();
    }
    match /activityLog/{id} {
      allow create: if isLibraryStaff();    // content-edit audit entries
      allow read, delete: if isAdminRole();
      allow update: if false;
    }
    // Basic type/size bounds on a logged error entry - the pre-auth create
    // path below needs no signed-in identity at all, so without this an
    // anonymous caller could write unbounded message/stack strings or a
    // fabricated userEmail attributing a fake "failed login" to a real
    // patron. Bounds are generous, not exact - abuse prevention, not strict
    // schema validation. (Ported from the pre-consolidation rules; the
    // consolidation had collapsed errorLogs to bare create-if-signedIn +
    // update-false, which silently broke BaseErrorLogHandler's pre-auth
    // failure logging AND its repeat-suppression recurrence updates - both
    // restored below.)
    function isValidErrorLogEntry() {
      return request.resource.data.message is string && request.resource.data.message.size() < 2000
        && request.resource.data.location is string && request.resource.data.location.size() < 200
        && (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() < 2000))
        && (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() < 8000))
        && (!('userEmail' in request.resource.data) || request.resource.data.userEmail == null
            || (request.resource.data.userEmail is string && request.resource.data.userEmail.size() < 320));
    }
    match /errorLogs/{id} {
      // Client error reporting - see BaseErrorLogHandler. Two create paths:
      // a signed-in user logging their OWN error (self-attributed), or a
      // FAILED LOGIN/SIGNUP/FORGOT-PASSWORD attempt - the one deliberate
      // unauthenticated-write exception in this file, tightly scoped: uid
      // null, location limited to those three values, app limited to the
      // client-writable values ('functions'-sourced entries only ever come
      // via the Admin SDK, which bypasses rules - so clients can't spoof
      // one).
      allow read, delete: if isAdminRole();
      allow create: if isValidErrorLogEntry() &&
        ((signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.app in ['reader', 'manager'])
         || (!signedIn() && request.resource.data.uid == null
             && request.resource.data.app in ['reader', 'manager']
             && request.resource.data.location in ['login', 'signup', 'forgotPassword']));
      // Repeat suppression (see BaseErrorLogHandler): a rapidly-recurring
      // error updates its episode's FIRST entry instead of creating one doc
      // per occurrence. The only mutation ever allowed, and only on the
      // author's own entries: exactly repeatCount + lastOccurredAt, count
      // monotonically increasing, last-seen never before the entry's own
      // start. Pre-auth (uid == null) entries have no update path at all.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repeatCount', 'lastOccurredAt'])
        && request.resource.data.repeatCount is int
        && request.resource.data.repeatCount >= 2
        && (!('repeatCount' in resource.data) || request.resource.data.repeatCount >= resource.data.repeatCount)
        && request.resource.data.lastOccurredAt is int
        && request.resource.data.lastOccurredAt >= resource.data.timestamp;
    }

    // ========================================================================
    // SECTION 5 - Reader-owned data
    // ========================================================================
    // Profile docs: ALL writes go through Cloud Functions now (Phase 6) -
    // recordMyLogin/createMyReaderProfile/updateMyPreferences + the license
    // grant/revoke functions. Nothing client-written remains on the doc, so
    // client writes are closed entirely: the old self-license-granting
    // vulnerability class is structurally gone.
    match /libraryUsers/{email} {
      allow read: if callerEmail() == email || isAdminRole();
      allow write: if false;

      // Stay-direct owner subcollections (offline-preserving split): the
      // owner's own study data, path-scoped - identity is the PATH, not a
      // spoofable field.
      match /lessonStatus/{lessonId} {
        allow read: if callerEmail() == email || isAdminRole();
        allow write: if callerEmail() == email;
      }
      match /lessonHighlights/{lessonId} {
        allow read: if callerEmail() == email || isAdminRole();
        allow write: if callerEmail() == email;
      }
      match /submissions/{lessonId} {
        allow read: if callerEmail() == email || isAdminRole();
        allow write: if callerEmail() == email;
      }
      match /fcmTokens/{token} {
        allow read, write: if callerEmail() == email;
      }
      // Inbox copies are function-written (sendLibraryUserMessage). The
      // owner's permitted mutations, restored from the pre-consolidation
      // rules (the port had closed delete entirely, silently breaking the
      // reader's inbox delete action - MessageService.deleteMessage):
      // flipping `read` to true (never editing content or un-reading), and
      // deleting a message they have ALREADY READ - an unread announcement
      // can't be dismissed unseen, and the adminMessages summary keeps the
      // sent record either way.
      match /messages/{id} {
        allow read: if callerEmail() == email;
        allow update: if callerEmail() == email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
          request.resource.data.read == true;
        allow delete: if callerEmail() == email && resource.data.read == true;
        allow create: if false;
      }
    }
    // Cross-user highlight discovery is not a thing; but lessonStatus etc.
    // are only ever read via their owner's path above - no collectionGroup
    // reads needed for patron data.

    match /discussionGroups/{groupId} {
      // Browse/detail for any signed-in patron; membership create/update
      // and group create/close go through Cloud Functions (Phase 6).
      // Admin's Groups screen still edits/deletes groups directly.
      allow read: if signedIn();
      allow update, delete: if isAdminRole();
      allow create: if false;

      // Roster read is membership-gated (sweep 2026-08-17): a member doc
      // is keyed by email and carries email/name/status - a bare signedIn()
      // read let any account enumerate every group's roster. The reader
      // only ever lists a group's members for a group the caller is in
      // (getGroupMembers), so gating to member/creator/admin breaks no
      // legitimate query. "My memberships" across groups is served
      // separately by the email-filtered collection-group rule below.
      match /members/{memberEmail} {
        allow read: if isAdminRole() || isGroupCreator(groupId) ||
          isApprovedGroupMember(groupId);
        allow delete: if isAdminRole();     // admin hard-delete cleanup
        allow create, update: if false;     // functions only
      }
      // Stay-direct interactive content: authored-as-self by an approved
      // member (one get() per write - the price of instant local echo).
      // Reads are membership-gated (sweep 2026-08-17): private pastoral
      // content (chat + prayer requests) must not be readable by any
      // signed-in account. isApprovedGroupMember(groupId) is evaluable at
      // query time (no resource.data reference), so the reader's unfiltered
      // per-group list queries still pass for an actual member.
      match /chatMessages/{id} {
        allow read: if isAdminRole() || isGroupCreator(groupId) ||
          isApprovedGroupMember(groupId);
        allow create: if isApprovedGroupMember(groupId) &&
          request.resource.data.senderEmail == callerEmail() &&
          request.resource.data.text is string &&
          request.resource.data.text.size() < 4000;
        allow update: if false;
        allow delete: if isAdminRole();
      }
      match /prayerRequests/{id} {
        allow read: if isAdminRole() || isGroupCreator(groupId) ||
          isApprovedGroupMember(groupId);
        allow create: if isApprovedGroupMember(groupId) &&
          request.resource.data.authorEmail == callerEmail() &&
          request.resource.data.text is string &&
          request.resource.data.text.size() < 4000;
        allow update: if false;
        // Author OR the group creator (moderation) OR admin. The creator
        // term was missing (Sweep 3, 2026-08-17): the reader shows a Remove
        // button on any prayer to the leader, but every leader-moderation
        // delete threw permission-denied and logged an error.
        allow delete: if resource.data.authorEmail == callerEmail() ||
          isGroupCreator(groupId) || isAdminRole();
      }
      // 1:1 leader<->member conversations: the conversation doc id is the
      // NON-creator participant's email; the thread is always between the
      // creator and that one member. Membership-gated (Sweep 3, 2026-08-17):
      // the otherEmail participant must have a member doc, and the caller
      // must be either that participant or the creator. Without this, any
      // signed-in patron could DM (and, via notifyConversationMessage, push
      // to) any leader, and a creator could open conversations/{anyEmail} to
      // push arbitrary text at any user whose email they know. isAdminRole()
      // read/delete lets moderation hard-delete the subtree.
      match /conversations/{otherEmail} {
        allow read: if isAdminRole() ||
          (groupMemberExists(groupId, otherEmail) &&
            (callerEmail() == otherEmail || isGroupCreator(groupId)));
        allow create, update: if groupMemberExists(groupId, otherEmail) &&
          (callerEmail() == otherEmail || isGroupCreator(groupId));
        allow delete: if isAdminRole();

        match /messages/{id} {
          allow read: if isAdminRole() ||
            (groupMemberExists(groupId, otherEmail) &&
              (callerEmail() == otherEmail || isGroupCreator(groupId)));
          allow create: if groupMemberExists(groupId, otherEmail) &&
            (callerEmail() == otherEmail || isGroupCreator(groupId)) &&
            request.resource.data.senderEmail == callerEmail() &&
            request.resource.data.text is string &&
            request.resource.data.text.size() < 4000;
          allow update: if false;
          allow delete: if isAdminRole();     // moderation hard-delete
        }
      }
    }

    // License pool: every mutation is a Cloud Function. Reads are
    // owner-scoped (sweep 2026-08-17): a bare signedIn() read let any
    // account list every license (leader emails + assignment PII). The
    // reader only ever queries its own, filtered by leaderEmail == me or
    // assignedToEmail == me, so those equality filters make an owner-scoped
    // read rule provable; admin sees all.
    match /groupLicenses/{id} {
      allow read: if isAdminRole() ||
        resource.data.leaderEmail == callerEmail() ||
        resource.data.assignedToEmail == callerEmail();
      allow write: if false;
    }
    // Send/cancel are functions now; leaders list their own sent invites
    // (leaderEmail-filtered). Invitee preview/accept/decline all go through
    // functions (getInviteDetails/accept/decline), so a direct read is only
    // ever a leader listing their own - scope it (sweep 2026-08-17): a bare
    // signedIn() read let anyone enumerate every invite (invitee emails +
    // status) and mine invite ids for decline-griefing.
    match /groupInvites/{id} {
      allow read: if isAdminRole() ||
        resource.data.leaderEmail == callerEmail();
      allow write: if false;
    }
    match /adminMessages/{id} {             // broadcast history (admin screen)
      allow read: if isAdminRole();
      allow write: if false;
    }

    // ========================================================================
    // Default deny - any collection not explicitly matched above.
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

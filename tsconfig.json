/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    // baseUrl was dropped 2026-08-26: TypeScript deprecated it, and 6.0+
    // reports it as an error in the editor ("will stop functioning in
    // TypeScript 7.0") even though the 5.8 pinned here still accepts it.
    // It was doing real work - 1,022 imports in this app are written bare
    // as 'src/app/...' rather than relatively - so it is replaced by an
    // explicit path mapping rather than deleted. Since TS 4.4 `paths`
    // resolve relative to this file, so no baseUrl is needed.
    "paths": {
      "@impact-common/*": ["./src/common/src/*"],
      "src/*": ["./src/*"]
    },
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}

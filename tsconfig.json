/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    // baseUrl was dropped 2026-08-26: TypeScript deprecated it, and 6.0+
    // reports it as an error in the editor ("will stop functioning in
    // TypeScript 7.0") even though the 5.8 pinned here still accepts it.
    // It was doing real work - 1,022 imports in this app are written bare
    // as 'src/app/...' rather than relatively - so it is replaced by an
    // explicit path mapping rather than deleted. Since TS 4.4 `paths`
    // resolve relative to this file, so no baseUrl is needed.
    "paths": {
      "@impact-common/*": ["./src/common/src/*"],
      "src/*": ["./src/*"]
    },
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // strict is the family switch, and until 2026-09-05 the two flags that
    // carry most of it were turned back off below (noImplicitAny and
    // strictNullChecks). The review put "turn the compiler on" first on its
    // list; measured, it cost 108 errors app-wide - two-thirds of them
    // untyped fromFirestore hooks in the DAO and its services - and found
    // getById() resolving undefined behind a Promise<T>, a shipping-label
    // update aimed at a document named "undefined", and two email resends
    // that threw a TypeError into the void. Both flags stay on.
    //
    // strictPropertyInitialization is the one still off: it is a different
    // kind of work (every @Input and every field a lifecycle hook fills in
    // wants `!` or an initialiser) and is tracked separately.
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}

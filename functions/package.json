{
  "name": "functions",
  "scripts": {
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy-dev": "firebase use impactdisciplesdev && firebase deploy --only functions",
    "deploy-prod": "firebase use impactdisciples-a82a8 && firebase deploy --only functions",
    "deploy-dev-safe": "firebase deploy --project impactdisciplesdev --only functions:create_payment_intent,functions:cancel_payment_intent,functions:refund_payment,functions:get_shipping_rates,functions:get_shipping_label,functions:create_paypal_order,functions:capture_paypal_order,functions:subscribe_to_email_list,functions:unsubscribe_from_email_list,functions:get_youtube_videos,functions:createAdminUser,functions:deleteAdminUser,functions:onEventRegistrationCreated,functions:onEventRegistrationUpdated,functions:onFormSubmissionCreated,functions:onFormSubmissionUpdated,functions:onPurchaseCreated,functions:onPurchaseUpdated,functions:onPurchaseFulfillmentEligible,functions:onPurchaseCustomerUpsert,functions:onEventRegistrationCustomerUpsert,functions:onPurchaseGrantLibraryLicenses,functions:onCustomerCreatedMailchimpSync,functions:onCustomerUpdatedMailchimpSync",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@angular/fire": "^18.0.1",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "shipengine": "^1.0.7",
    "stripe": "^16.7.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.0"
  },
  "private": true
}

{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "prebuild": "node scripts/sync-shared.js",
    "build": "tsc",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy-dev": "firebase use impactdisciplesdev && firebase deploy --only functions",
    "deploy-prod": "firebase use impactdisciples-a82a8 && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-reporter=spec \"test/*.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "shipengine": "^1.0.7",
    "pdfkit": "^0.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "eslint-config-google": "^0.14.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "@types/pdfkit": "^0.13.5"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1",
    "ts-deepmerge": "^8.0.0",
    "qs": "^6.16.0"
  }
}

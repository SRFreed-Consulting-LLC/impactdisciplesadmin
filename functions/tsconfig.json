{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": false,
    // Newer transitive .d.ts files (@google-cloud/storage 7.22+,
    // @types/node 20+) use TypeScript-5.7-era syntax this project's TS 4.9
    // can't parse - skip type-checking declaration files (our own src is
    // still fully checked).
    "skipLibCheck": true,
    "target": "es2017"
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}

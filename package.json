{
  "name": "impactdisciplesadmin",
  "version": "0.0.0",
  "scripts": {
    "start-local": "ng serve --configuration=local",
    "build-local": "ng build --configuration=local",
    "start-dev": "ng serve --configuration=development",
    "build-dev": "ng build --configuration=development",
    "build-deploy-dev": "ng build --configuration=development && firebase use impactdisciplesdev && firebase deploy --only hosting:development",
    "start-prod": "ng serve --configuration=production",
    "build-prod": "ng build --configuration=production",
    "build-deploy-prod": "ng build --configuration=production && firebase use impactdisciples-a82a8 && firebase deploy --only hosting:production",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "start-emu": "ng serve --configuration=emulator --port=5200",
    "emu": "node scripts/write-emulator-env.js && npm --prefix functions run build && npx -y firebase-tools@15.28.1 emulators:start --project demo-impact --only auth,firestore,functions,storage",
    "emu:seed": "node scripts/seed-emulator.js",
    "test:integration": "node --test --test-concurrency=1 \"integration/*.test.js\"",
    "test:rules": "node --test \"integration/rules/*.test.js\" && node integration/rules/reader-rules.js",
    "e2e": "playwright test",
    "e2e:cross": "playwright test --config=playwright.cross.config.ts",
    "backup:dev": "node scripts/export.js --project=dev",
    "backup:prod": "node scripts/export.js --project=prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.27",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.27",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.27",
    "@angular/platform-browser-dynamic": "^20.3.27",
    "@angular/router": "^20.3.27",
    "@fontsource/inter": "^5.3.0",
    "@formio/js": "^5.5.1",
    "angular-calendar": "^0.32.2",
    "bootstrap": "^5.1.3",
    "dompurify": "^3.4.13",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^11.8.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "ngx-cookie-service": "^20.1.1",
    "ngx-quill": "^28.0.2",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20.3.33",
    "@angular/compiler-cli": "^20.3.27",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@material/material-color-utilities": "^0.4.0",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~4.3.0",
    "@types/leaflet": "^1.9.22",
    "angular-eslint": "^21.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

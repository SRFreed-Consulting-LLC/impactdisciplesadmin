rules_version = '2';

// Cloud Storage rules for this app's bucket.
//
// Ported from impact-discipleship-library-manager-new's storage.rules - the
// ONLY use is the AI Book Import flow, which drops a temporary source PDF
// under book-imports/{uid}/ for the importBookFromPdf Cloud Function to read
// via the Admin SDK (which bypasses these rules) and then deletes it.
// Everything else stays denied.
//
// Deploy explicitly with `firebase deploy --only storage` - not part of
// npm run deploy:dev, to avoid touching the bucket by surprise. Admin
// authorization for the import itself is enforced server-side by the
// callable's requireAdminRole - but the temp upload area is ALSO gated to
// staff here via the `role` CUSTOM CLAIM ('Admin'|'Root'), which
// admin-claims.functions.ts mirrors from the caller's admin_users doc into
// their Auth token. (admin_users itself can't be checked directly from
// Storage rules: it isn't keyed by uid the way a firestore.get() needs an
// exact document path - it's found by a `where firebaseUID == uid` query,
// which these rules have no way to run. The claim sidesteps that.) The
// same 'Admin'/'Root' set is what requireAdminRole accepts, so anyone able
// to complete the import callable can also upload.
service firebase.storage {
  match /b/{bucket}/o {
    match /book-imports/{uid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.get('role', '') in ['Admin', 'Root']
        && request.resource.size < 32 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      // The Cloud Function reads via the Admin SDK; clients never need to read.
      allow read: if false;
    }

    // Staff file management (2026-08-20): app-image-uploader is the admin
    // app's file browser for EVERY image/file pick (products, events,
    // Team Page, Home Page Images, email designer, ebooks...) - it lists,
    // uploads to, and organizes this bucket directly from the client. The
    // blanket deny below broke every one of those pickers with
    // storage/unauthorized the moment these rules deployed (live-diagnosed:
    // 403 listing the bucket root from the Team Page dialog). Gate is the
    // same `role` CUSTOM CLAIM as Firestore's rules - all four staff tiers,
    // since Employees manage store/content images and Editors manage
    // library lesson images. Anonymous/public access stays fully denied -
    // the public site reads images via tokened download URLs, which don't
    // evaluate these rules.
    // book-imports/ is EXCLUDED here. Storage grants on ANY matching allow,
    // so without this exclusion the catch-all silently shadowed the stricter
    // rule above and made all four of its constraints unreachable - the
    // uid-scoping, the Admin/Root-only gate, the 32MB cap and the
    // application/pdf content-type check. The reader believed four things
    // were enforced and none were, and an Editor - the least-trusted tier -
    // had write over every other admin's import staging.
    //
    // allPaths[0] is the first path segment. The uploader browses the bucket
    // root and needs everything else, which is why this is an exclusion
    // rather than an allow-list of prefixes: narrowing it to named prefixes
    // is what broke every image picker on 2026-08-20 (storage/unauthorized,
    // live-diagnosed from the Team Page dialog).
    match /{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.get('role', '') in ['Admin', 'Root', 'Employee', 'Editor'];
      allow write: if request.auth != null
        && request.auth.token.get('role', '') in ['Admin', 'Root', 'Employee', 'Editor']
        && allPaths[0] != 'book-imports'
        && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }
  }
}
